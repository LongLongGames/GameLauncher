<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GameLauncher</RootNamespace>
    <AssemblyName>GameLauncher</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>LongLongGames</Authors>
    <Product>GameLauncher</Product>
    <Description>LongLongGames PC Official Launcher (P0)</Description>
    <!-- 有 Program.cs（Velopack 入口）时保留；没有 Program.cs 就删掉下一行 -->
    <StartupObject>GameLauncher.Program</StartupObject>
	<ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
	<Content Include="Assets/app.ico" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- 缺这个就会报 Velopack / UpdateInfo / VelopackApp 找不到 -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
