<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GameLauncher</RootNamespace>
    <AssemblyName>GameLauncher</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>LongLongGames</Authors>
    <Product>GameLauncher</Product>
    <Description>LongLongGames PC Official Launcher (P0)</Description>
    <StartupObject>GameLauncher.Program</StartupObject>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- exe / 任务栏 / pack URI 用；托盘从同一资源流加载 -->
    <Resource Include="Assets/app.ico" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 封面与游戏图标等松散文件 -->
    <Content Include="Assets/**/*" Exclude="Assets/app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
