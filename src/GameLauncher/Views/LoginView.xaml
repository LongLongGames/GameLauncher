<UserControl x:Class="GameLauncher.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GameLauncher.ViewModels">
  <Grid>
    <Border Background="{StaticResource BrushBgPanel}"
            CornerRadius="12"
            Padding="36,32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MinWidth="360"
            MaxWidth="420">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45" Color="#000"/>
      </Border.Effect>
      <StackPanel>
        <TextBlock Text="LongLongGames"
                   FontSize="13"
                   Foreground="{StaticResource BrushAccent}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Text="登录启动器"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}"
                   Margin="0,0,0,6"/>
        <TextBlock Text="使用官方账号（MP）登录"
                   FontSize="12"
                   Foreground="{StaticResource BrushTextSecondary}"
                   Margin="0,0,0,24"/>

        <TextBlock Text="用户名" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
        <TextBox Style="{StaticResource DarkTextBox}"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,14"/>

        <TextBlock Text="密码" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
        <PasswordBox x:Name="PwdBox"
                     Style="{StaticResource DarkPasswordBox}"
                     Margin="0,0,0,8"
                     PasswordChanged="PwdBox_OnPasswordChanged"/>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource BrushDanger}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,4,0,12"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>

        <Button Content="登录"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                HorizontalAlignment="Stretch"
                Margin="0,8,0,0"/>

        <TextBlock Text="联调：确保本机 MP 已启动 (localhost:11080)"
                   FontSize="11"
                   Foreground="{StaticResource BrushTextMuted}"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
