<UserControl x:Class="GameLauncher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GameLauncher.Views">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="88"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 左侧游戏图标 Tab -->
    <Border Grid.Column="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="游戏"
                   FontSize="11"
                   Foreground="{StaticResource BrushTextMuted}"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,8"/>
        <ListBox ItemsSource="{Binding Games}"
                 SelectedItem="{Binding SelectedGame}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="8,4"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="6">
                      <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgElevated}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgElevated}"/>
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                        <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="56" HorizontalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="10"
                        Background="{StaticResource BrushBgElevated}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                  <TextBlock Text="{Binding GameId}"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource BrushAccent}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                </Border>
                <TextBlock Text="{Binding Title}"
                           FontSize="10"
                           Foreground="{StaticResource BrushTextSecondary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="56"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 右侧详情 -->
    <Grid Grid.Column="1" Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,16">
        <Button DockPanel.Dock="Right"
                Content="退出登录"
                Style="{StaticResource GhostButton}"
                Command="{Binding LogoutCommand}"/>
        <TextBlock VerticalAlignment="Center">
          <Run Text="你好，" Foreground="{StaticResource BrushTextSecondary}"/>
          <Run Text="{Binding UserDisplay, Mode=OneWay}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
        </TextBlock>
      </DockPanel>

      <Border Grid.Row="1"
              Background="{StaticResource BrushBgPanel}"
              CornerRadius="12"
              Padding="28"
              BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="1">
        <Grid>
          <StackPanel Visibility="{Binding SelectedGame, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding SelectedGame.Title}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}"/>
            <TextBlock Text="{Binding SelectedGame.Description}"
                       FontSize="13"
                       Foreground="{StaticResource BrushTextSecondary}"
                       Margin="0,6,0,20"
                       TextWrapping="Wrap"/>

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="最新版本" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
              <TextBlock Grid.Row="0" Grid.Column="2"
                         Text="{Binding SelectedGame.LatestVersion, TargetNullValue=—}"
                         Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="本地版本" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
              <TextBlock Grid.Row="2" Grid.Column="2"
                         Text="{Binding Detail.LocalVersionText}"
                         Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>

              <TextBlock Grid.Row="4" Grid.Column="0" Text="状态" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
              <TextBlock Grid.Row="4" Grid.Column="2"
                         Text="{Binding Detail.StatusText}"
                         Foreground="{StaticResource BrushAccent}" FontSize="13"/>
            </Grid>

            <ProgressBar Height="6"
                         Minimum="0" Maximum="1"
                         Value="{Binding Detail.Progress}"
                         Visibility="{Binding Detail.ShowProgress, Converter={StaticResource BoolToVisibility}}"
                         Margin="0,0,0,16"
                         Background="{StaticResource BrushBgElevated}"
                         Foreground="{StaticResource BrushAccent}"
                         BorderThickness="0"/>

            <Button Content="{Binding Detail.ActionText}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding Detail.ActionCommand}"
                    IsEnabled="{Binding Detail.ActionEnabled}"
                    HorizontalAlignment="Left"
                    MinWidth="120"/>
          </StackPanel>

          <TextBlock Text="{Binding ErrorMessage}"
                     Foreground="{StaticResource BrushDanger}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"/>

          <TextBlock Text="暂无已注册游戏"
                     Foreground="{StaticResource BrushTextMuted}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Visibility="{Binding SelectedGame, Converter={StaticResource NullToVisible}}"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
