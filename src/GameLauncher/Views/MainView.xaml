<UserControl x:Class="GameLauncher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GameLauncher.Views"
             xmlns:conv="clr-namespace:GameLauncher.Converters">
  <UserControl.Resources>
    <conv:GameIconConverter x:Key="GameIcon"/>
    <conv:NullImageToVisibilityConverter x:Key="NullImageVis"/>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="96"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 左侧游戏图标 Tab -->
    <Border Grid.Column="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="游戏"
                   FontSize="11"
                   Foreground="{StaticResource BrushTextMuted}"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,8"/>
        <ListBox ItemsSource="{Binding Games}"
                 SelectedItem="{Binding SelectedGame}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ClipToBounds="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <!-- 左右各 6：选中描边预留后不再顶破 96 列宽 -->
              <Setter Property="Margin" Value="6,4"/>
              <Setter Property="HorizontalContentAlignment" Value="Center"/>
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <!--
                      关键：选中时 BorderThickness 从 0→2，总宽 +4，在 88 列里右侧被裁。
                      修复：始终 thickness=2，未选中用透明描边，布局尺寸不变。
                    -->
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="10"
                            Padding="4"
                            SnapsToDevicePixels="True">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgElevated}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgElevated}"/>
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="56" Height="56" CornerRadius="8" ClipToBounds="True"
                      Background="{StaticResource BrushBgElevated}">
                <!-- 底层：game_id 文字占位 -->
                <Grid>
                  <TextBlock Text="{Binding GameId}"
                             FontSize="10"
                             Foreground="{StaticResource BrushTextSecondary}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="52"/>
                  <!-- 有图则盖住文字 -->
                  <Image Source="{Binding Converter={StaticResource GameIcon}}"
                         Stretch="UniformToFill"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 右侧详情 -->
    <Grid Grid.Column="1">
      <!-- 背景封面图 -->
      <Image Source="{Binding Detail.CoverImage}"
             Stretch="UniformToFill"
             Opacity="0.85"
             SnapsToDevicePixels="True"/>
      <!-- 底部渐变遮罩，保证文字可读 -->
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#800D1117" Offset="0"/>
            <GradientStop Color="#B30D1117" Offset="0.45"/>
            <GradientStop Color="#D90D1117" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
          <Button DockPanel.Dock="Right"
                  Content="退出登录"
                  Style="{StaticResource GhostButton}"
                  Command="{Binding LogoutCommand}"/>
          <TextBlock VerticalAlignment="Center" FontSize="13">
            <Run Text="你好，" Foreground="{StaticResource BrushTextMuted}"/>
            <Run Text="{Binding UserDisplay, Mode=OneWay}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
          </TextBlock>
        </DockPanel>

        <Border Grid.Row="1"
                Background="#99161B22"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28">
          <Grid>
            <StackPanel Visibility="{Binding SelectedGame, Converter={StaticResource NullToCollapsed}}">
              <TextBlock Text="{Binding SelectedGame.Title}"
                         FontSize="28" FontWeight="Bold"
                         Foreground="{StaticResource BrushTextPrimary}"
                         Margin="0,0,0,8"/>
              <TextBlock Text="{Binding SelectedGame.Description}"
                         FontSize="13"
                         Foreground="{StaticResource BrushTextSecondary}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,20"
                         MaxWidth="560"
                         HorizontalAlignment="Left"/>

              <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="8"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="8"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="最新版本" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{Binding SelectedGame.LatestVersion, TargetNullValue=—}"
                           Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="本地版本" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                <TextBlock Grid.Row="2" Grid.Column="2"
                           Text="{Binding Detail.LocalVersionText}"
                           Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="状态" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                <TextBlock Grid.Row="4" Grid.Column="2"
                           Text="{Binding Detail.StatusText}"
                           Foreground="{StaticResource BrushAccent}" FontSize="13"/>
              </Grid>

              <ProgressBar Height="6"
                           Minimum="0" Maximum="1"
                           Value="{Binding Detail.Progress}"
                           Visibility="{Binding Detail.ShowProgress, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,0,0,16"
                           Background="{StaticResource BrushBgElevated}"
                           Foreground="{StaticResource BrushAccent}"
                           BorderThickness="0"/>

              <Button Content="{Binding Detail.ActionText}"
                      Style="{StaticResource PrimaryButton}"
                      Command="{Binding Detail.ActionCommand}"
                      IsEnabled="{Binding Detail.ActionEnabled}"
                      HorizontalAlignment="Left"
                      MinWidth="120"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource BrushDanger}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="暂无已注册游戏"
                       Foreground="{StaticResource BrushTextMuted}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Visibility="{Binding SelectedGame, Converter={StaticResource NullToVisible}}"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
