<Window x:Class="GameLauncher.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Width="380" Height="260"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBgPanel}"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="1"
        ShowInTaskbar="False">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="✕"
              Style="{StaticResource StatusBarButton}" Padding="6,2"
              Click="Close_Click"/>
      <TextBlock Text="关于 GameLauncher"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{StaticResource BrushTextPrimary}"/>
    </DockPanel>

    <StackPanel Grid.Row="1">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Border Width="40" Height="40" CornerRadius="8"
                Background="{StaticResource BrushAccent}" Margin="0,0,12,0">
          <TextBlock Text="LL" FontSize="14" FontWeight="Bold"
                     Foreground="#FF0D1117"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="GameLauncher" FontSize="15" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushTextPrimary}"/>
          <TextBlock Text="LongLongGames PC 官方启动器" FontSize="12"
                     Foreground="{StaticResource BrushTextMuted}"/>
        </StackPanel>
      </StackPanel>

      <TextBlock x:Name="VersionBlock"
                 FontSize="13"
                 Foreground="{StaticResource BrushTextSecondary}"
                 Margin="0,4,0,0"/>
      <TextBlock x:Name="ChannelBlock"
                 FontSize="12"
                 Foreground="{StaticResource BrushTextMuted}"
                 Margin="0,4,0,0"/>
      <TextBlock Text="更新源：GitHub Releases（Velopack）" FontSize="11"
                 Foreground="{StaticResource BrushTextMuted}" Margin="0,12,0,0"/>
    </StackPanel>

    <Button Grid.Row="2" Content="检查更新" HorizontalAlignment="Right"
            Style="{StaticResource PrimaryButton}" Padding="16,8"
            Click="CheckUpdate_Click"/>
  </Grid>
</Window>
