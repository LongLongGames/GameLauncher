<Window x:Class="GameLauncher.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动器更新"
        Width="420" Height="220"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBgPanel}"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="1"
        ShowInTaskbar="False">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right"
              Content="✕"
              Style="{StaticResource StatusBarButton}"
              Padding="6,2"
              Click="Close_Click"
              ToolTip="稍后"/>
      <TextBlock Text="启动器需要更新"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{StaticResource BrushTextPrimary}"
                 VerticalAlignment="Center"/>
    </DockPanel>

    <StackPanel Grid.Row="1">
      <TextBlock x:Name="MessageBlock"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource BrushTextSecondary}"
                 FontSize="13"
                 LineHeight="20"/>
      <TextBlock x:Name="VersionBlock"
                 Margin="0,10,0,0"
                 FontSize="12"
                 Foreground="{StaticResource BrushTextMuted}"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="稍后"
              Style="{StaticResource GhostButton}"
              Padding="16,8"
              Margin="0,0,8,0"
              Click="Later_Click"/>
      <Button Content="立即更新并重启"
              Style="{StaticResource PrimaryButton}"
              Padding="16,8"
              Click="Update_Click"/>
    </StackPanel>
  </Grid>
</Window>
