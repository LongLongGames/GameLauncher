<Application x:Class="GameLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GameLauncher.Converters"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- 全局转换器：LoginView / MainView 都依赖这些 key -->
      <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
      <conv:NullToVisibleConverter x:Key="NullToVisible"/>
      <conv:InvertBoolConverter x:Key="InvertBool"/>
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
